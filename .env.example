# Local development config. Copy to .env for local runs.
# Real values arrive as environment at deploy time and are never committed.
# The app runs correctly with every value left blank.

# Umami analytics. Both must be set for the script to load.
VITE_UMAMI_URL=https://analytics.example.com/script.js
VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Error tracking (GlitchTip / Sentry). Set to enable.
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.example.com/0
